{
  "expo": {
    "name": "NutriWork",
    "slug": "nutriwork",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutriwork.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nutriwork.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "NutriWork uses the camera so you can photograph meals and ingredients.",
          "photosPermission": "NutriWork reads photos you pick of meals and ingredients."
        }
      ]
    ],
    "scheme": "nutriwork"
  }
}
